{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Packwright",
  "version": "0.1.0",
  "identifier": "com.packwright.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Packwright",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost ws: wss:; worker-src 'self' blob:; frame-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/packwiz.exe"],
    "windows": {
      "nsis": {
        "installerHooks": "nsis-hooks.nsh"
      },
      "wix": {
        "template": "wix-template.wxs"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzMTJDRUM4RkEwNjdFQ0IKUldUTGZnYjZ5TTRTczhodDY3K1IvODNYMnRHcmwrcmVYRnZGRzN4M2R4bVZZM0xHcFI5dUJmdkkK",
      "endpoints": [
        "https://github.com/bgrados31/packwright/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
